# Copy this template to .env and fill in the appropriate values.
# Lines beginning with # are comments and ignored.

# Optional override for the Chrome/Chromium executable.
# Windows users must quote paths containing spaces; example:
# CHROME_BINARY="C:\Program Files\Google\Chrome\Application\chrome.exe"
# Unix-like systems can point to /usr/bin/google-chrome or another Chromium build.
# CHROME_BINARY=/usr/bin/google-chrome
